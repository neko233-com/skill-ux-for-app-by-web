{
  "meta": {
    "title": "工作台",
    "device": "phone",
    "renderMode": "hi"
  },
  "kind": "app",
  "style": "ios-clean",
  "nav": {
    "mode": "tabs",
    "items": [
      { "screen": "home", "label": "首页", "icon": "home" },
      { "screen": "data", "label": "数据", "icon": "bar-chart", "badge": 2 },
      { "screen": "me", "label": "我的", "icon": "user" }
    ]
  },
  "screens": [
    {
      "id": "home",
      "title": "工作台",
      "blocks": [
        { "type": "search", "props": { "placeholder": "搜索订单 / 客户" } },
        {
          "type": "hero",
          "props": {
            "title": "今日待办 6",
            "sub": "3 条高优先级",
            "motif": "clipboard",
            "cta": { "label": "开始处理", "toast": "开始" }
          }
        },
        {
          "type": "grid",
          "props": {
            "cols": 4,
            "items": [
              { "icon": "edit", "title": "新建", "detail": { "title": "新建", "desc": "工作项 / 文档 / 日程", "icon": "edit" } },
              { "icon": "send", "title": "审批", "detail": { "title": "审批", "desc": "待我处理 2 条", "icon": "send" } },
              { "icon": "calendar", "title": "日程", "detail": { "title": "日程", "desc": "今日 3 个会议", "icon": "calendar" } },
              { "icon": "folder", "title": "文档", "to": "data" }
            ]
          }
        },
        {
          "type": "list",
          "props": {
            "items": [
              { "icon": "file", "title": "Q3 预算复核", "sub": "财务 · 2h 前", "to": "data" },
              { "icon": "users", "title": "客户 A 拜访纪要", "sub": "销售 · 昨天", "detail": { "title": "拜访纪要", "desc": "客户关注交付节奏，下周补方案", "icon": "users" } },
              { "icon": "rocket", "title": "v1.2 发布清单", "sub": "研发 · 昨天" }
            ]
          }
        }
      ]
    },
    {
      "id": "data",
      "title": "数据",
      "blocks": [
        {
          "type": "tabs",
          "props": { "items": [{ "label": "本周", "active": true }, { "label": "本月" }, { "label": "自定义" }] }
        },
        {
          "type": "stats",
          "props": {
            "items": [
              { "label": "营收", "countTo": 128400, "countPrefix": "¥", "icon": "trending-up", "tone": "primary" },
              { "label": "订单", "countTo": 326, "icon": "shopping-cart" },
              { "label": "转化", "value": "4.8%", "icon": "target" }
            ]
          }
        },
        {
          "type": "chart",
          "props": { "values": [42, 58, 35, 72, 64, 88, 76], "labels": ["一", "二", "三", "四", "五", "六", "日"] }
        },
        {
          "type": "table",
          "props": {
            "head": ["渠道", "订单", "营收"],
            "rows": [["直营", "128", "¥52,300"], ["分销", "96", "¥41,200"], ["线上", "102", "¥34,900"]]
          }
        }
      ]
    },
    {
      "id": "me",
      "title": "我的",
      "blocks": [
        { "type": "profile", "props": { "name": "陈小北", "sub": "产品策划", "avatar": "user" } },
        {
          "type": "settings",
          "props": {
            "items": [
              { "label": "消息通知", "type": "toggle", "value": true },
              { "label": "深色模式", "type": "toggle", "value": false },
              { "label": "语言", "type": "select", "value": "简体中文" },
              { "label": "关于", "type": "link", "value": "v1.2.0" }
            ]
          }
        },
        {
          "type": "buttons",
          "props": {
            "items": [
              {
                "label": "退出登录",
                "variant": "danger",
                "block": true,
                "detail": { "title": "退出登录", "desc": "确定要退出当前账号吗？", "ok": "退出", "icon": "log-out" }
              }
            ]
          }
        }
      ]
    }
  ]
}
